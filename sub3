<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>amirito (main page)</title><meta name="description" content="Scroll to bring every fresh ingredient together into a whole burger."><style>
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f3f0e8;color:#2d382b;font-family:Arial,Helvetica,sans-serif}.scene{height:290svh}.stage{height:100svh;min-height:600px;position:sticky;top:0;overflow:hidden}.brand{position:absolute;top:30px;left:4%;font-size:28px;font-weight:900;letter-spacing:-2px}.brand span{color:#c96635}.number{position:absolute;right:4%;top:40px;font-size:10px;letter-spacing:2px}.composition{position:absolute;left:50%;top:49%;width:min(66vw,72svh,720px);aspect-ratio:1;transform:translate(-50%,-50%)}.ingredient{position:absolute;left:0;top:37.5%;width:100%;height:25%;background-image:url('ingredients-realistic-v2.png');background-size:100% 600%;background-repeat:no-repeat;filter:drop-shadow(0 12px 9px #4b321623);will-change:transform}.ingredient:nth-child(1){z-index:6;background-position:50% 0%}.ingredient:nth-child(2){z-index:5;background-position:50% 20%}.ingredient:nth-child(3){z-index:4;background-position:50% 40%}.ingredient:nth-child(4){z-index:3;background-position:50% 60%}.ingredient:nth-child(5){z-index:2;background-position:50% 80%}.ingredient:nth-child(6){z-index:1;background-position:50% 100%}.floor-shadow{position:absolute;left:24%;width:52%;height:4%;bottom:7%;background:#4c3e20;filter:blur(14px);border-radius:50%;opacity:.12;transform:scaleX(.8)}.labels{position:absolute;inset:0;pointer-events:none}.label{position:absolute;top:50%;font-size:clamp(12px,1.1vw,16px);font-family:Georgia,serif;font-style:italic;white-space:nowrap;display:flex;align-items:center;gap:18px}.label:after{content:'';width:clamp(28px,6vw,100px);height:1px;background:#b5b7a7}.label.left{right:76%}.label.right{left:76%;flex-direction:row-reverse}.label:nth-child(1){margin-top:-43.75%}.label:nth-child(2){margin-top:-26.25%}.label:nth-child(3){margin-top:-8.75%}.label:nth-child(4){margin-top:8.75%}.label:nth-child(5){margin-top:26.25%}.label:nth-child(6){margin-top:43.75%}.whole{position:absolute;top:75%;width:100%;text-align:center;opacity:0;transform:translateY(20px);font:italic clamp(36px,5.5vw,76px)/1.1 Georgia,serif;letter-spacing:-2px;pointer-events:none}.footer{position:absolute;left:4%;right:4%;bottom:24px;display:flex;justify-content:space-between;align-items:center;font-size:9px;text-transform:uppercase;letter-spacing:2px}.hint{display:flex;gap:12px;align-items:center}.hint span{font-size:22px}.progress{display:flex;gap:12px;align-items:center}.track{width:80px;height:1px;background:#c7c7b8}.fill{height:1px;background:#36432c;width:0}.replay{color:inherit;background:none;border:0;padding:10px;cursor:pointer;font:inherit;letter-spacing:inherit;text-transform:inherit}.replay:hover{text-decoration:underline}.end-space{height:10svh}@media(max-width:700px){.stage{min-height:560px}.composition{width:78vw;top:47%}.label{font-size:11px;gap:5px}.label:after{width:18px}.label.left{right:76%}.label.right{left:76%}.whole{top:78%;font-size:43px;letter-spacing:-1px}.brand{top:22px;left:6%}.number{right:6%;top:32px}.footer{left:6%;right:6%;font-size:8px;letter-spacing:1px}.track{width:40px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.scene{height:100svh}.hint{visibility:hidden}}
.ingredient{top:calc(50% - var(--height)/2);height:var(--height);background-size:100% auto}.ingredient:nth-child(1){--height:28.32%;background-position:50% 0%}.ingredient:nth-child(2){--height:26.37%;background-position:50% 22.91%}.ingredient:nth-child(3){--height:22.46%;background-position:50% 42.88%}.ingredient:nth-child(4){--height:21%;background-position:50% 59.80%}.ingredient:nth-child(5){--height:24.9%;background-position:50% 78.45%}.ingredient:nth-child(6){--height:26.95%;background-position:50% 100%}</style></head><body><main class="scene" aria-label="Scroll to assemble a burger"><div class="stage"><div class="brand">amirito<span>.</span></div><div class="number">01 / 06</div><div class="composition" role="img" aria-label="Sesame bun, lettuce, tomato, cheddar, beef patty and bottom bun assembling into a burger"><div class="floor-shadow" style="transform: scaleX(0.8);"></div><div id="layers"><div class="ingredient" data-open="-1.75" data-close="-.77" style="transform: translateY(-229.688px);"></div><div class="ingredient" data-open="-1.05" data-close="-.32" style="transform: translateY(-137.812px);"></div><div class="ingredient" data-open="-.35" data-close="-.10" style="transform: translateY(-45.9375px);"></div><div class="ingredient" data-open=".35" data-close=".09" style="transform: translateY(45.9375px);"></div><div class="ingredient" data-open="1.05" data-close=".36" style="transform: translateY(137.812px);"></div><div class="ingredient" data-open="1.75" data-close=".79" style="transform: translateY(229.688px);"></div></div><div class="labels" style="opacity: 1;"><div class="label left">Sesame bun</div><div class="label right">Fresh lettuce</div><div class="label left">Sliced tomato</div><div class="label right">Cheddar cheese</div><div class="label left">Grilled beef</div><div class="label right">Toasted bun</div></div></div><div class="whole" style="opacity: 0; transform: translateY(20px);">A whole sandwich.</div><div class="footer"><div class="hint" style="opacity: 1;"><span>↓</span> Scroll to assemble</div><div class="progress"><span id="percent">00%</span><div class="track"><div class="fill" style="width: 0%;"></div></div></div><button class="replay" aria-label="Scroll to top to see the ingredients again">Start again ↗</button></div></div></main><div class="end-space" aria-hidden="true"></div><script>
const scene=document.querySelector('.scene'),composition=document.querySelector('.composition'),layers=[...document.querySelectorAll('.ingredient')],reduced=matchMedia('(prefers-reduced-motion: reduce)');let pending=false;
function draw(){const distance=scene.offsetHeight-innerHeight,p=reduced.matches?1:Math.min(1,Math.max(0,-scene.getBoundingClientRect().top/Math.max(1,distance)));const t=p*p*(3-2*p);const size=composition.clientWidth*.25;layers.forEach(el=>{el.style.transform=`translateY(${(+el.dataset.open+(+el.dataset.close-el.dataset.open)*t)*size}px)`});document.querySelector('.labels').style.opacity=1-Math.min(1,p*2.5);const reveal=Math.min(1,Math.max(0,(p-.78)/.22));const title=document.querySelector('.whole');title.style.opacity=reveal;title.style.transform=`translateY(${(1-reveal)*20}px)`;document.querySelector('.fill').style.width=p*100+'%';document.querySelector('#percent').textContent=String(Math.round(p*100)).padStart(2,'0')+'%';document.querySelector('.hint').style.opacity=1-reveal;document.querySelector('.number').textContent=String(Math.min(6,1+Math.floor(p*6))).padStart(2,'0')+' / 06';document.querySelector('.floor-shadow').style.transform=`scaleX(${.8+t*.25})`;pending=false}
function schedule(){if(!pending){pending=true;requestAnimationFrame(draw)}}addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule);reduced.addEventListener('change',schedule);document.querySelector('.replay').addEventListener('click',()=>scrollTo({top:0,behavior:reduced.matches?'instant':'smooth'}));draw();
</script>


